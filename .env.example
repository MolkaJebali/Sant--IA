# API Groq (LLM & Whisper Transcription)
# Obtenez votre clé sur https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Base de données (MySQL / MariaDB ou Docker)
# Exemple local XAMPP: mysql+pymysql://root:@localhost:3306/health_db
# Exemple Docker: mysql+pymysql://user:password@db:3306/health_db
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/health_db

# Sécurité & Authentification JWT
JWT_SECRET=your_jwt_secret_key_change_me
